    {
      "name": "Identity and filing details",
      "items": [
        {
          "id": "ssn",
          "label": "Social Security numbers or ITINs for everyone on the return",
          "detail": "Send through the secure portal, never by plain email.",
          "when": [],
          "basis": "irs"
        },
        {
          "id": "names-address",
          "label": "Legal names as shown with the Social Security Administration, and current address",
          "detail": "",
          "when": [],
          "basis": "irs"
        },
        {
