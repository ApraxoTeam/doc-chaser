{
  "id": "tax-individual-1040",
  "title": "Individual tax return (Form 1040) document request",
  "industry": "tax",
  "jurisdiction": "US federal",
  "note": "Built from the IRS list of what to gather before filing. State returns and unusual situations need more items.",
  "sources": {
    "irs": {
      "name": "IRS, Gather your documents",
      "url": "https://www.irs.gov/filing/gather-your-documents"
    },
    "practice": {
      "name": "Common practice",
      "url": ""
    }
  },
  "situations": {
    "wages": "Had a job with a W-2",
    "self-employed": "Freelance, gig or business income",
    "investments": "Interest, dividends or sold investments",
    "digital-assets": "Bought, sold or received digital assets",
    "retirement": "Took money from a pension, annuity or IRA",
    "social-security": "Received Social Security benefits",
    "unemployment": "Received unemployment or other government payments",
    "gambling": "Had gambling or lottery winnings",
    "marketplace-insurance": "Had Health Insurance Marketplace coverage",
    "dependents": "Paid for child or dependent care",
    "homeowner": "Owns a home",
    "itemizing": "Expects to itemize deductions",
    "charity": "Gave to charity",
    "hsa": "Contributed to an HSA or FSA",
    "education": "Paid tuition or is an educator",
    "retirement-contributions": "Contributed to a retirement account",
    "estimated-payments": "Made estimated tax payments",
    "new-client": "New client of the firm"
